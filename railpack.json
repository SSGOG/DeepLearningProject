{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12"
  },
  "buildAptPackages": [
    "libgl1",
    "libglib2.0-0",
    "libxcb1",
    "libx11-6",
    "libxext6",
    "libxrender1"
  ],
  "steps": {
    "install": {
      "commands": [
        "...",
        "pip uninstall -y opencv-python || true",
        "pip install --force-reinstall opencv-python-headless==4.12.0.88"
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "libgl1",
      "libglib2.0-0",
      "libxcb1",
      "libx11-6",
      "libxext6",
      "libxrender1"
    ]
  }
}
